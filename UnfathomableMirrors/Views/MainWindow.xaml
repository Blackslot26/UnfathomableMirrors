<Window x:Class="UnfathomableMirrors.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulador Óptico Avanzado - Laboratorio de Física"
        Height="820"
        Width="1450"
        KeyDown="Window_KeyDown"
        Background="#FAFAFA">
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        Grid.ColumnSpan="3"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Background="White">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="15,0">
                                <Button Content="📏 Regla Métrica"
                                        Click="ToggleRuler_Click"
                                        Padding="12,6"
                                        Background="#E1BEE7"
                                        Cursor="Hand"
                                        FontWeight="SemiBold"/>
                                <CheckBox x:Name="ShowGuidesCheck"
                                          Content="Mostrar Líneas Normales"
                                          IsChecked="False"
                                          VerticalAlignment="Center"
                                          Margin="25,0,0,0"
                                          FontWeight="SemiBold"
                                          Click="ShowGuides_Click"/>
                                <Button Content="💾 Guardar Escena"
                                        Click="Save_Click"
                                        Padding="8,6"
                                        Margin="25,0,0,0"
                                        Background="#C8E6C9"
                                        Cursor="Hand"/>
                                <Button Content="📂 Cargar Escena"
                                        Click="Load_Click"
                                        Padding="8,6"
                                        Margin="5,0,0,0"
                                        Background="#B3E5FC"
                                        Cursor="Hand"/>
                                <TextBlock x:Name="MeasureLabel"
                                           Text=""
                                           Foreground="Purple"
                                           VerticalAlignment="Center"
                                           Margin="25,0,0,0"
                                           FontWeight="Bold"
                                           FontSize="13"/>
                                <TextBlock x:Name="ModeLabel"
                                           Text="Modo: MOVER"
                                           Foreground="DodgerBlue"
                                           VerticalAlignment="Center"
                                           Margin="35,0,0,0"
                                           FontSize="14"
                                           FontWeight="Bold"/>
                        </StackPanel>
                </Border>

                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Background="#F4F4F4"
                      Margin="0,0,5,0">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="240"/>
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Margin="5">
                                <TabItem Header="Fuentes de Luz">
                                        <StackPanel Margin="10,15,10,10">
                                                <TextBlock Text="Densidad de Rayos:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,2"/>
                                                <TextBox x:Name="RayDensityInput"
                                                         Text="12"
                                                         Margin="0,0,0,15"
                                                         Padding="4"
                                                         PreviewTextInput="NumberValidation"/>

                                                <TextBlock Text="Longitud de Onda:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,2"/>
                                                <Slider x:Name="WavelengthSlider"
                                                        Minimum="380"
                                                        Maximum="750"
                                                        Value="550"
                                                        TickFrequency="10"
                                                        IsSnapToTickEnabled="True"
                                                        ValueChanged="WavelengthSlider_ValueChanged"/>
                                                <TextBlock x:Name="WavelengthLabel"
                                                           Text="550 nm"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,2,0,20"
                                                           FontSize="12"/>

                                                <Button Content="➕ Añadir Rayo Simple"
                                                        Click="AddRay_Click"
                                                        Padding="5,8"
                                                        Margin="0,4"
                                                        Background="#E0E0E0"
                                                        FontWeight="SemiBold"/>
                                                <Button Content="🌈 Añadir Espectro Completo"
                                                        Click="AddWhiteLight_Click"
                                                        Padding="5,8"
                                                        Margin="0,4"
                                                        Background="#F0E6FA"
                                                        FontWeight="SemiBold"/>
                                                <Button Content="💡 Añadir Lámpara Radial"
                                                        Click="AddLamp_Click"
                                                        Padding="5,8"
                                                        Margin="0,4"
                                                        Background="#FFF9C4"
                                                        FontWeight="SemiBold"/>
                                                <Button Content="橫 Añadir Haz Láser Paralelo"
                                                        Click="AddLaserBeam_Click"
                                                        Padding="5,8"
                                                        Margin="0,4"
                                                        Background="#FFCDD2"
                                                        FontWeight="SemiBold"/>
                                        </StackPanel>
                                </TabItem>

                                <TabItem Header="Componentes Ópticos">
                                        <StackPanel Margin="10,15,10,10">
                                                <TextBlock Text="Tipo de Superficie:"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,4"/>
                                                <ComboBox x:Name="SurfaceSelector"
                                                          SelectedIndex="0"
                                                          Margin="0,0,0,15"
                                                          Padding="4">
                                                        <ComboBoxItem Content="Espejo Curvo"/>
                                                        <ComboBoxItem Content="Espejo Recto"/>
                                                        <ComboBoxItem Content="Bloque de Refracción"/>
                                                        <ComboBoxItem Content="Lente Biconvexa"/>
                                                </ComboBox>

                                                <TextBlock Text="Radio de Curvatura (px):"
                                                           FontSize="11"
                                                           Margin="0,0,0,2"/>
                                                <TextBox x:Name="RadiusInput"
                                                         Text="600"
                                                         Margin="0,0,0,10"
                                                         Padding="4"
                                                         PreviewTextInput="NumberValidation"/>

                                                <TextBlock Text="Largo / Apertura (px):"
                                                           FontSize="11"
                                                           Margin="0,0,0,2"/>
                                                <TextBox x:Name="LengthInput"
                                                         Text="240"
                                                         Margin="0,0,0,10"
                                                         Padding="4"
                                                         PreviewTextInput="NumberValidation"/>

                                                <TextBlock Text="Espesor / Ancho (px):"
                                                           FontSize="11"
                                                           Margin="0,0,0,2"/>
                                                <TextBox x:Name="ThicknessInput"
                                                         Text="100"
                                                         Margin="0,0,0,10"
                                                         Padding="4"
                                                         PreviewTextInput="NumberValidation"/>

                                                <TextBlock Text="Índice de Refracción (n):"
                                                           FontSize="11"
                                                           Margin="0,0,0,2"/>
                                                <TextBox x:Name="IndexInput"
                                                         Text="1.5"
                                                         Margin="0,0,0,20"
                                                         Padding="4"/>

                                                <Button Content="➕ Instanciar Superficie"
                                                        Click="AddSurface_Click"
                                                        Padding="10,8"
                                                        Background="#E0E0E0"
                                                        FontWeight="Bold"/>
                                        </StackPanel>
                                </TabItem>
                        </TabControl>

                        <GroupBox Grid.Row="1"
                                  Header="Ecuaciones Físicas Aplicadas"
                                  Margin="8"
                                  Padding="5"
                                  Background="White"
                                  BorderBrush="LightGray">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="FormulasTextBlock"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   FontFamily="Consolas"
                                                   Foreground="#222222"/>
                                </ScrollViewer>
                        </GroupBox>
                </Grid>

                <Canvas x:Name="SimCanvas"
                        Grid.Row="1"
                        Grid.Column="1"
                        Background="Transparent"
                        ClipToBounds="True"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"/>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        BorderBrush="LightGray"
                        BorderThickness="1,0,0,0"
                        Background="#F8F8F8">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Telemetría Analítica"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="10,12,10,8"
                                           HorizontalAlignment="Center"/>
                                <DataGrid x:Name="PhysicsDataTable"
                                          Grid.Row="1"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F2F2F2"
                                          Margin="5"/>
                        </Grid>
                </Border>
        </Grid>
</Window>