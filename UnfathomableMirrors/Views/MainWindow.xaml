<Window x:Class="UnfathomableMirrors.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unfathomable Mirrors - Analytical Edition"
        Height="750"
        Width="1350"
        KeyDown="Window_KeyDown"
        Background="#FAFAFA">
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="2"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Background="White">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="15,0">
                                <Button Content="➕ Add Ray"
                                        Click="AddRay_Click"
                                        Padding="12,8"
                                        FontWeight="Bold"
                                        Background="#E0E0E0"
                                        Cursor="Hand"/>
                                <Button Content="🌈 Add White Light"
                                        Click="AddWhiteLight_Click"
                                        Padding="12,8"
                                        Margin="5,0,0,0"
                                        FontWeight="Bold"
                                        Background="#F0E6FA"
                                        Cursor="Hand"/>

                                <TextBlock Text="Add:"
                                           VerticalAlignment="Center"
                                           Margin="15,0,5,0"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <ComboBox x:Name="SurfaceSelector"
                                          Width="120"
                                          VerticalAlignment="Center"
                                          SelectedIndex="0">
                                        <ComboBoxItem Content="Curved Mirror"/>
                                        <ComboBoxItem Content="Straight Mirror"/>
                                        <ComboBoxItem Content="Refraction Block"/>
                                        <ComboBoxItem Content="Biconvex Lens"/>
                                </ComboBox>
                                <Button Content="➕ Add Surface"
                                        Click="AddSurface_Click"
                                        Padding="10,6"
                                        Margin="5,0,0,0"
                                        Background="#E0E0E0"
                                        Cursor="Hand"/>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="15,0,0,0">
                                        <TextBlock Text="Rad:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBox x:Name="RadiusInput"
                                                 Text="600"
                                                 Width="35"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 PreviewTextInput="NumberValidation"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="Len/Th:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBox x:Name="LengthInput"
                                                 Text="240"
                                                 Width="35"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 PreviewTextInput="NumberValidation"/>
                                        <TextBox x:Name="ThicknessInput"
                                                 Text="100"
                                                 Width="35"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 Margin="2,0,0,0"
                                                 PreviewTextInput="NumberValidation"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                        <TextBlock Text="Index(n):"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"
                                                   FontWeight="SemiBold"/>
                                        <TextBox x:Name="IndexInput"
                                                 Text="1.5"
                                                 Width="35"
                                                 VerticalAlignment="Center"
                                                 Padding="2"/>
                                </StackPanel>

                                <CheckBox x:Name="ShowGuidesCheck"
                                          Content="Guides"
                                          IsChecked="False"
                                          VerticalAlignment="Center"
                                          Margin="15,0,0,0"
                                          FontWeight="SemiBold"
                                          Click="ShowGuides_Click"/>
                                <TextBlock x:Name="ModeLabel"
                                           Text="Mode: MOVING ('A')"
                                           Foreground="DodgerBlue"
                                           VerticalAlignment="Center"
                                           Margin="15,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                        </StackPanel>
                </Border>

                <Canvas x:Name="SimCanvas"
                        Grid.Row="1"
                        Grid.Column="0"
                        Background="Transparent"
                        ClipToBounds="True"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"/>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1,0,0,0"
                        Background="#F8F8F8">
                        <DataGrid x:Name="PhysicsDataTable"
                                  AutoGenerateColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F0F0F0"
                                  Margin="5"/>
                </Border>
        </Grid>
</Window>