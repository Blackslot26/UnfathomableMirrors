<Window x:Class="UnfathomableMirrors.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unfathomable Mirrors - Analytical Lab Edition"
        Height="800"
        Width="1420"
        KeyDown="Window_KeyDown"
        Background="#FAFAFA">
        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="2"
                        BorderBrush="LightGray"
                        BorderThickness="0,0,0,1"
                        Background="White">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="10,0">
                                        <Button Content="➕ Ray"
                                                Click="AddRay_Click"
                                                Padding="8,6"
                                                FontWeight="Bold"
                                                Background="#E0E0E0"
                                                Cursor="Hand"/>
                                        <Button Content="🌈 Spectrum"
                                                Click="AddWhiteLight_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                FontWeight="Bold"
                                                Background="#F0E6FA"
                                                Cursor="Hand"/>
                                        <Button Content="💡 Lamp"
                                                Click="AddLamp_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#FFF9C4"
                                                Cursor="Hand"/>
                                        <Button Content="🔦 Laser"
                                                Click="AddLaserBeam_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#FFCDD2"
                                                Cursor="Hand"/>
                                        <Button Content="衡量 Ruler"
                                                Click="ToggleRuler_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#E1BEE7"
                                                Cursor="Hand"/>
                                        <Button Content="💾 Save"
                                                Click="Save_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#C8E6C9"
                                                Cursor="Hand"/>
                                        <Button Content="📂 Load"
                                                Click="Load_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#B3E5FC"
                                                Cursor="Hand"/>

                                        <TextBlock Text="Wavelength:"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,4,0"
                                                   FontWeight="SemiBold"/>
                                        <Slider x:Name="WavelengthSlider"
                                                Minimum="380"
                                                Maximum="750"
                                                Value="550"
                                                Width="90"
                                                VerticalAlignment="Center"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                ValueChanged="WavelengthSlider_ValueChanged"/>
                                        <TextBlock x:Name="WavelengthLabel"
                                                   Text="550 nm"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"
                                                   Width="50"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="Add Surface:"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,4,0"
                                                   FontWeight="SemiBold"/>
                                        <ComboBox x:Name="SurfaceSelector"
                                                  Width="110"
                                                  VerticalAlignment="Center"
                                                  SelectedIndex="0">
                                                <ComboBoxItem Content="Curved Mirror"/>
                                                <ComboBoxItem Content="Straight Mirror"/>
                                                <ComboBoxItem Content="Refraction Block"/>
                                                <ComboBoxItem Content="Biconvex Lens"/>
                                        </ComboBox>
                                        <Button Content="➕ Add"
                                                Click="AddSurface_Click"
                                                Padding="8,6"
                                                Margin="4,0,0,0"
                                                Background="#E0E0E0"
                                                Cursor="Hand"/>

                                        <TextBlock Text="Rad:"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,2,0"
                                                   FontSize="11"/>
                                        <TextBox x:Name="RadiusInput"
                                                 Text="600"
                                                 Width="30"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 PreviewTextInput="NumberValidation"/>

                                        <TextBlock Text="Len/Th:"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"
                                                   FontSize="11"/>
                                        <TextBox x:Name="LengthInput"
                                                 Text="240"
                                                 Width="30"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 PreviewTextInput="NumberValidation"/>
                                        <TextBox x:Name="ThicknessInput"
                                                 Text="100"
                                                 Width="30"
                                                 VerticalAlignment="Center"
                                                 Padding="2"
                                                 Margin="2,0,0,0"
                                                 PreviewTextInput="NumberValidation"/>

                                        <TextBlock Text="Index(n):"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,2,0"
                                                   FontSize="11"/>
                                        <TextBox x:Name="IndexInput"
                                                 Text="1.5"
                                                 Width="25"
                                                 VerticalAlignment="Center"
                                                 Padding="2"/>

                                        <CheckBox x:Name="ShowGuidesCheck"
                                                  Content="Guides"
                                                  IsChecked="False"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  FontWeight="SemiBold"
                                                  Click="ShowGuides_Click"/>
                                        <TextBlock x:Name="MeasureLabel"
                                                   Text=""
                                                   Foreground="Purple"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   FontWeight="Bold"
                                                   MaxWidth="150"/>
                                        <TextBlock x:Name="ModeLabel"
                                                   Text="Mode: MOVING"
                                                   Foreground="DodgerBlue"
                                                   VerticalAlignment="Center"
                                                   Margin="15,0,0,0"
                                                   FontWeight="SemiBold"/>
                                </StackPanel>
                        </ScrollViewer>
                </Border>

                <Canvas x:Name="SimCanvas"
                        Grid.Row="1"
                        Grid.Column="0"
                        Background="Transparent"
                        ClipToBounds="True"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"/>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1,0,0,0"
                        Background="#F8F8F8">
                        <Grid>
                                <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Telemetría Analítica"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Margin="10,10,10,5"
                                           HorizontalAlignment="Center"/>
                                <DataGrid x:Name="PhysicsDataTable"
                                          Grid.Row="1"
                                          AutoGenerateColumns="True"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single"
                                          RowBackground="White"
                                          AlternatingRowBackground="#F0F0F0"
                                          Margin="5"/>
                        </Grid>
                </Border>
        </Grid>
</Window>